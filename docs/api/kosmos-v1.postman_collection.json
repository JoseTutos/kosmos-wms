            "description": "Solo OPERARIO. 200 { data: { token, tipo, expira_en, usuario } }. 401 CREDENCIALES_INVALIDAS · 423/403 USUARIO_BLOQUEADO, USUARIO_INACTIVO, ROL_SIN_ACCESO. Throttle 10/min.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operario@kosmos.local\",\n  \"password\": \"********\",\n  \"dispositivo\": \"Zebra TC21 · Muelle 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { pm.collectionVariables.set('token', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
